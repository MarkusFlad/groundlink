<!-- ReatMetric core configuration for testing the groundlink example sle_spacecraft. -->
<ns1:core xmlns:ns1="http://dariolucia.eu/reatmetric/core/configuration">
	<name>groundlink SLE test</name>
	<log-property-file>@CONFIG_DIR@/log.properties</log-property-file>
	<archive-location>@CONFIG_DIR@/archive</archive-location>
	<definitions-location>@CONFIG_DIR@/processing</definitions-location>
	<driver name="Spacecraft Driver"
		type="eu.dariolucia.reatmetric.driver.spacecraft.SpacecraftDriver"
		configuration="@CONFIG_DIR@/spacecraft" />
	<!-- Bind the SLE service instances (RAF first in the file) at start-up. -->
	<autostart-connectors startup="true" reconnect="false" />
</ns1:core>
